# orthus — Solar 대회 빌드 환경 변수 예시.
# 시크릿 값은 절대 커밋하지 않는다. 키 "이름"만 이 파일에 남긴다.

# --- DB ------------------------------------------------------------------
ORTHUS_PG_DSN=postgresql+psycopg://orthus:orthus@localhost:5433/orthus
# structured 분기의 이중 방어(read-only 롤). make up + migrate가 만든다.
ORTHUS_PG_DSN_READONLY=postgresql+psycopg://orthus_ro:orthus_ro@localhost:5433/orthus

# LLM wiki markdown source-of-record root.
ORTHUS_WIKI_STORE=wiki-store

# --- LLM (Solar 단일) ----------------------------------------------------
# chat/compile 슬롯: mock | solar. mock은 결정론 오프라인(테스트/CI) 슬롯.
ORTHUS_LLM=solar
ORTHUS_LLM_SOLAR_API_KEY=
ORTHUS_LLM_SOLAR_BASE_URL=https://api.upstage.ai/v1
ORTHUS_LLM_SOLAR_MODEL=solar-pro

# 작업별 배정 테이블(orthus/models/orchestration.py — 전 슬롯 solar) 활성화.
ORTHUS_MODEL_ORCHESTRATION_ENABLED=true

# SVC 구조화 검증 캐스케이드 2차 모델 — 같은 벤더의 다른 모델을 쓴다.
# 빈 값이면 캐스케이드 off (fail-closed).
ORTHUS_LLM_FALLBACK_PROVIDER=solar
ORTHUS_LLM_FALLBACK_MODEL=solar-mini

# --- Embedding (Solar) ---------------------------------------------------
# retrieval index 슬롯: mock | solar.
# embedding-passage를 인덱스/질의 양쪽에 대칭으로 쓴다(실측 최적 — RESULTS.md 참조).
ORTHUS_EMBEDDING=solar
ORTHUS_EMBEDDING_SOLAR_API_KEY=
ORTHUS_EMBEDDING_SOLAR_BASE_URL=https://api.upstage.ai/v1
ORTHUS_EMBEDDING_SOLAR_MODEL=embedding-passage
ORTHUS_EMBEDDING_DIMENSIONS=1024

# --- 에이전틱 검색 -------------------------------------------------------
# /ask를 Solar 네이티브 function-calling 루프로 구동 (fail-closed 기본 off).
ORTHUS_AGENTIC_ASK_ENABLED=true
# 복합 질문 decompose + 병렬 fan-out.
ORTHUS_ASK_DECOMPOSE_ENABLED=true

# --- 지식그래프 (Neo4j, K-series) ---------------------------------------
# fail-closed 기본 off. 켜기 전 make kg-bootstrap + kg-rebuild 선행.
ORTHUS_KG_ENABLED=false
ORTHUS_KG_URI=bolt://127.0.0.1:7687
ORTHUS_KG_USER=neo4j
ORTHUS_KG_PASSWORD=orthus-kg-local

# --- 노드/인증 (로컬 데모) ----------------------------------------------
ORTHUS_NODE_ID=company
ORTHUS_NODE_KIND=company
ORTHUS_AUTH_MODE=demo
ORTHUS_CORS_ORIGINS=http://localhost:3820,http://127.0.0.1:3820
